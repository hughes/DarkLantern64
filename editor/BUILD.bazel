load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "cc_test")

cc_library(
    name = "character_preview",
    hdrs = ["character_preview.h"],
    deps = ["@dl64_animation//:animation", "@nlohmann_json//:json"],
)

cc_library(
    name = "character_preview_mesh",
    hdrs = ["character_preview_mesh.h"],
    deps = ["@lightengine//:lightengine"],
)

cc_test(
    name = "character_preview_test",
    srcs = ["test_character_preview.cpp"],
    deps = [":character_preview"],
)

cc_test(
    name = "character_preview_material_test",
    srcs = ["test_character_preview_material.cpp"],
    data = ["testdata/uv_probe.gltf"],
    args = ["$(rootpath testdata/uv_probe.gltf)"],
    deps = [":character_preview", ":character_preview_mesh", "@lightengine//:lightengine", "@bazel_tools//tools/cpp/runfiles"],
)

cc_binary(
    name = "darklantern64_project_editor",
    srcs = ["main.cpp"],
    copts = select({"@platforms//os:windows": ["/wd4005"], "//conditions:default": []}),
    deps = [":character_preview", ":character_preview_mesh", "@lightengine//:lightengine"],
)

cc_binary(
    name = "darklantern64_editor",
    srcs = ["main.cpp"],
    copts = select({"@platforms//os:windows": ["/wd4005"], "//conditions:default": []}),
    deps = [":character_preview", ":character_preview_mesh", "@lightengine//:lightengine"],
)

# Separate executable lets a scene workshop build while the original workshop
# remains open on Windows, where a running executable cannot be replaced.
cc_binary(
    name = "darklantern64_scene_editor",
    srcs = ["main.cpp"],
    copts = select({"@platforms//os:windows": ["/wd4005"], "//conditions:default": []}),
    deps = [":character_preview", ":character_preview_mesh", "@lightengine//:lightengine"],
)
