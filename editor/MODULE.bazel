module(name = "darklantern64_editor", version = "0.1.0")
bazel_dep(name = "rules_cc", version = "0.2.14")
bazel_dep(name = "platforms", version = "0.0.10")
bazel_dep(name = "lightengine", version = "0.1.0")
local_path_override(module_name = "lightengine", path = "../external/LightEngine")

# Compile exactly the portable sampler used by the ROM; do not maintain an
# editor-specific animation implementation or a copied set of runtime headers.
new_local_repository = use_repo_rule("@bazel_tools//tools/build_defs/repo:local.bzl", "new_local_repository")
new_local_repository(
    name = "dl64_animation",
    path = "..",
    build_file_content = """
load("@rules_cc//cc:defs.bzl", "cc_library")
cc_library(
    name = "animation",
    srcs = ["src/animation.c", "src/game.c", "src/tick.c", "src/mission.c", "src/world_stream.c", "src/stream_scene.c", "src/stream_coordinator.c"],
    hdrs = ["src/animation.h", "src/game.h", "src/enemy_types.def", "src/tick.h", "src/mission.h", "src/world_stream.h", "src/stream_scene.h", "src/stream_coordinator.h", "src/runtime_trace.h", "src/content_limits.h"],
    includes = ["src"],
    copts = select({"@platforms//os:windows": ["/std:c11"], "//conditions:default": []}),
    visibility = ["//visibility:public"],
)
""",
)
lightengine_deps = use_extension("@lightengine//bazel:deps_ext.bzl", "lightengine_deps")
use_repo(lightengine_deps, "nlohmann_json")
