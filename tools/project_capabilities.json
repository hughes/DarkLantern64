    {
      "id": "streamed-native-play",
      "label": "Streamed Native Play",
      "state": "limited",
      "description": "Cooked DLM1 package chunks and shared coordinator drive demand, queued doors, floor support, preparation/publication/retirement and persistent mission state. CRC/SHA identity checks, delay injection and inspector snapshots are available. Rendering policy classification is shared; host shader work and timing do not certify the ROM.",
      "limits": [
