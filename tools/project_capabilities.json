    {
      "id": "runtime-regions",
      "label": "Runtime regions and visibility",
      "state": "limited",
      "description": "Manual ownership, activation bounds, directed paired gates and independent authored visible sets feed the shared transactional coordinator. Stable sets and transition unions must satisfy bridge capacity. Visibility authoring has no automatic BSP/PVS compiler. Portable packages can exceed the runtime region cap and then remain inspectable with target failures.",
      "limits": [
        "portable_package_regions",
        "runtime_regions",
        "resident_regions",
