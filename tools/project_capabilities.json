        }
      ]
    },
    {
      "id": "rom-play",
      "label": "ROM play",
      "state": "limited",
      "description": "Ordinary resident C assets and bounded streamed DLM1 missions run through libdragon/Tiny3D. The default RSP backend transforms, rigidly deforms and clips; the CPU reference remains available. Source-bound Ares functional/lifecycle/strict workload checks exist. Larger missions and original hardware need separate acceptance.",
      "limits": [
        "required_memory",
        "scene_models",
        "scene_vertices",
        "scene_triangles",
        "stream_chunk_bytes"
      ],
