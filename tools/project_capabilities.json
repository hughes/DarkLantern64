        }
      ]
    },
    {
      "id": "static-lighting",
      "label": "Static lighting and diagnostics",
      "state": "limited",
      "description": "Baked inline closed/open states support at most one global independent door. Standalone baked assets and live night fallbacks have explicit policy reasons; multiple doors disable the inline shortcut and lighting changes can require live work. Publication/revision reports identify source/package/build and cost scope. Estimates and unknown costs remain distinct from measured timing/heap.",
      "limits": [
        "inline_independent_doors"
      ],
      "source_references": [
        {
          "path": "src/lighting_policy.h",
          "symbol": "dl_lighting_inline_payload"
        },
        {
          "path": "src/lighting_policy.c",
          "symbol": "dl_lighting_decision"
        }
      ]
    },
    {
      "id": "character-animation",
      "label": "Resident character animation",
      "state": "limited",
      "description": "Shared immutable meshes/skeletons/quantized keys, independent actor playback, two-clip blending, connected one-influence geometry, bounded head attention and traveled-distance foot contacts are implemented. Host cooked-character caches use source/recipe identity; runtime pose/render caches stay bounded by scene storage. Animated scale, multiple vertex influences, general graphs/IK and cold-clip streaming are unavailable.",
      "limits": [
        "animation_bones",
        "animation_clips",
        "animation_samples",
        "animation_events",
        "animation_sockets"
      ],
      "source_references": [
