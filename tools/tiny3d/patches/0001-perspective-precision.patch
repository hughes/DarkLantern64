+/**
+ * DL64 precision patch, mathematical source for the manually scheduled .S code.
+ * The hardware reciprocal is a lookup approximation to 0.5/W. A Newton step
+ * removes its first-order error. Scale the residual before its fixed16.16
+ * multiply so rounding does not throw away the correction at distant geometry.
+ * Only the reciprocal's w/W lanes are consumed by callers. Projected XYZ,
+ * vertex alpha (including game fog), lighting and UV interpolation are retained.
+ * Valid normalized clipping W lies around 0..2; scaling by128 fits signed16.16.
+ * The shipped assembly uses retained clipping-cache W and dead temporary lanes
+ * to avoid growing the70-vertex cache. It was edited manually, not retranspiled.
+ */
+macro dl64RefineHalfInverse(vec32 original, vec32 reciprocal)
+{
+  vec32 scaledW = original.wwwwWWWW;
+  scaledW *= 128;
+  vec32 residual = scaledW * reciprocal.wwwwWWWW;
+  residual -= 64;
+  vec32 correction = reciprocal.wwwwWWWW * residual;
+  correction += 0.00048828125; //32/65536: round when shifting right by6
+  correction >>= 6;
+  reciprocal -= correction;
+}
